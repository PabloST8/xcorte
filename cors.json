[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE", "OPTIONS"],
    "maxAgeSeconds": 3600,
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Range",
      "Content-Range",
      "X-Requested-With",
      "Access-Control-Allow-Origin"
    ]
  }
]
